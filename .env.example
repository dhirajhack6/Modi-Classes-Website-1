# Modi Classes Web App Environment Variables Template

APP_URL=https://modi-classes-website-1.onrender.com

# Neon PostgreSQL Database Connection String
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Admin Portal Credentials
ADMIN_EMAIL="admin@modiclasses.in"
ADMIN_PASSWORD="ModiAdmin@2026"

# OTP Configuration (Optional for real OTP sending, fallbacks to console log/demo mode if not set)
# 1. SMTP Email settings (e.g. Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SENDER='"Modi Railway Classes" <your-email@gmail.com>'

# 2. Twilio SMS settings (for phone number OTP)
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="+1234567890"

# PhonePe UPI Payment Gateway Configuration
# Mode: "UAT" (Testing/Sandbox) or "PRODUCTION" (Real live money payments)
PHONEPE_ENV="UAT"
# For live payments, replace with your live Merchant ID and Salt Key from PhonePe Business Dashboard:
PHONEPE_MERCHANT_ID="PGTESTPAYUAT"
PHONEPE_SALT_KEY="099eb0cd-02cf-4e2a-8aca-3e6c6aff0399"
PHONEPE_SALT_INDEX="1"
PHONEPE_MERCHANT_NAME="Modi Railway Classes"
PHONEPE_UPI_VPA="modiclasses@okhdfcbank"

